# Elliott Wave Trading Bot Configuration
# Copy this file to .env and fill in your values

# ===================
# API Configuration
# ===================
# For real trading, add your broker API credentials
BROKER_API_KEY=your_api_key_here
BROKER_API_SECRET=your_api_secret_here

# ===================
# Trading Parameters
# ===================
# Starting capital for paper trading
STARTING_CAPITAL=10000

# Maximum percentage of capital to risk per trade
RISK_PER_TRADE=2.0

# Maximum number of concurrent positions
MAX_POSITIONS=5

# Default symbols to trade (comma-separated)
DEFAULT_SYMBOLS=AAPL,MSFT,GOOGL,AMZN,TSLA

# Trading timeframe (1m, 5m, 15m, 1h, 4h, 1d)
TIMEFRAME=1h

# ===================
# Elliott Wave Settings
# ===================
# Minimum wave length in bars
MIN_WAVE_LENGTH=5

# Fibonacci tolerance for wave ratios (percentage)
FIB_TOLERANCE=10.0

# Wave detection lookback period
WAVE_LOOKBACK=100

# ===================
# Risk Management
# ===================
# Stop loss percentage
STOP_LOSS_PCT=2.0

# Take profit percentage
TAKE_PROFIT_PCT=6.0

# Trailing stop activation percentage
TRAILING_STOP_PCT=3.0

# ===================
# Logging
# ===================
LOG_LEVEL=INFO
LOG_FILE=logs/trading.log

# ===================
# Mode
# ===================
# Set to 'paper' for simulation, 'live' for real trading
TRADING_MODE=paper
