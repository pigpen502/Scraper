//@version=5
indicator("Elliott Wave Auto-Detection", overlay=true, max_labels_count=500, max_lines_count=500)

// ==================== INPUTS ====================
// Wave Detection Settings
pivotLength = input.int(5, "Pivot Detection Length", minval=2, maxval=20, group="Wave Detection")
minWaveLength = input.int(5, "Minimum Wave Length (bars)", minval=2, maxval=50, group="Wave Detection")
fibTolerance = input.float(15.0, "Fibonacci Tolerance %", minval=5.0, maxval=30.0, group="Wave Detection")

// Display Settings
showWaveLabels = input.bool(true, "Show Wave Labels", group="Display")
showWaveLines = input.bool(true, "Show Wave Lines", group="Display")
showFibLevels = input.bool(true, "Show Fibonacci Levels", group="Display")
showTargets = input.bool(true, "Show Price Targets", group="Display")
showInvalidation = input.bool(true, "Show Invalidation Level", group="Display")

// Colors
bullColor = input.color(color.green, "Bullish Wave Color", group="Colors")
bearColor = input.color(color.red, "Bearish Wave Color", group="Colors")
fibColor = input.color(color.blue, "Fibonacci Color", group="Colors")
targetColor = input.color(color.orange, "Target Color", group="Colors")
invalidColor = input.color(color.purple, "Invalidation Color", group="Colors")

// ==================== PIVOT DETECTION ====================
// Find swing highs and lows
pivotHigh = ta.pivothigh(high, pivotLength, pivotLength)
pivotLow = ta.pivotlow(low, pivotLength, pivotLength)

// Store pivot information
var float[] pivotPrices = array.new_float(0)
var int[] pivotBars = array.new_int(0)
var bool[] pivotTypes = array.new_bool(0)  // true = high, false = low

// Track pivots
if not na(pivotHigh)
    // Check if we should add this pivot (alternating rule)
    if array.size(pivotTypes) == 0 or not array.get(pivotTypes, array.size(pivotTypes) - 1)
        array.push(pivotPrices, pivotHigh)
        array.push(pivotBars, bar_index - pivotLength)
        array.push(pivotTypes, true)
    else
        // Same type - keep higher one
        if pivotHigh > array.get(pivotPrices, array.size(pivotPrices) - 1)
            array.set(pivotPrices, array.size(pivotPrices) - 1, pivotHigh)
            array.set(pivotBars, array.size(pivotBars) - 1, bar_index - pivotLength)

if not na(pivotLow)
    if array.size(pivotTypes) == 0 or array.get(pivotTypes, array.size(pivotTypes) - 1)
        array.push(pivotPrices, pivotLow)
        array.push(pivotBars, bar_index - pivotLength)
        array.push(pivotTypes, false)
    else
        // Same type - keep lower one
        if pivotLow < array.get(pivotPrices, array.size(pivotPrices) - 1)
            array.set(pivotPrices, array.size(pivotPrices) - 1, pivotLow)
            array.set(pivotBars, array.size(pivotBars) - 1, bar_index - pivotLength)

// Limit array size to last 20 pivots
maxPivots = 20
if array.size(pivotPrices) > maxPivots
    array.shift(pivotPrices)
    array.shift(pivotBars)
    array.shift(pivotTypes)

// ==================== WAVE VALIDATION FUNCTIONS ====================
// Check if Wave 2 is valid (doesn't retrace more than 100% of Wave 1)
validateWave2(w1Start, w1End, w2End, isUptrend) =>
    if isUptrend
        w2End > w1Start  // Wave 2 bottom must be above Wave 1 start
    else
        w2End < w1Start  // Wave 2 top must be below Wave 1 start

// Check if Wave 3 is not the shortest
validateWave3NotShortest(w1Length, w3Length, w5Length) =>
    w3Length >= w1Length or w3Length >= w5Length

// Check if Wave 4 doesn't overlap Wave 1 (for impulse waves)
validateWave4NoOverlap(w1End, w4End, isUptrend) =>
    if isUptrend
        w4End > w1End  // Wave 4 low must be above Wave 1 high
    else
        w4End < w1End  // Wave 4 high must be below Wave 1 low

// Calculate Fibonacci retracement
fibRetracement(high_val, low_val, level) =>
    diff = high_val - low_val
    high_val - diff * level

// ==================== WAVE PATTERN DETECTION ====================
var int waveCount = 0
var string currentPattern = "none"
var bool isBullish = true
var float wave1Start = na
var float wave1End = na
var float wave2End = na
var float wave3End = na
var float wave4End = na
var float wave5End = na
var int wave1StartBar = na
var int wave1EndBar = na
var int wave2EndBar = na
var int wave3EndBar = na
var int wave4EndBar = na
var int wave5EndBar = na
var float confidence = 0.0

// Detect 5-wave impulse pattern
detectImpulseWave() =>
    detected = false
    bullish = true
    conf = 0.0

    if array.size(pivotPrices) >= 6
        // Get last 6 pivots for 5-wave pattern
        p0 = array.get(pivotPrices, array.size(pivotPrices) - 6)
        p1 = array.get(pivotPrices, array.size(pivotPrices) - 5)
        p2 = array.get(pivotPrices, array.size(pivotPrices) - 4)
        p3 = array.get(pivotPrices, array.size(pivotPrices) - 3)
        p4 = array.get(pivotPrices, array.size(pivotPrices) - 2)
        p5 = array.get(pivotPrices, array.size(pivotPrices) - 1)

        t0 = array.get(pivotTypes, array.size(pivotTypes) - 6)

        // Determine if bullish or bearish
        bullish := not t0  // If first pivot is a low, it's bullish

        // Calculate wave lengths
        w1Length = math.abs(p1 - p0)
        w2Length = math.abs(p2 - p1)
        w3Length = math.abs(p3 - p2)
        w4Length = math.abs(p4 - p3)
        w5Length = math.abs(p5 - p4)

        // Validate wave rules
        rule1 = validateWave2(p0, p1, p2, bullish)  // Wave 2 < 100% retrace
        rule2 = validateWave3NotShortest(w1Length, w3Length, w5Length)  // Wave 3 not shortest
        rule3 = validateWave4NoOverlap(p1, p4, bullish)  // Wave 4 no overlap

        if rule1 and rule2 and rule3
            detected := true
            conf := 0.7

            // Check Fibonacci relationships for higher confidence
            w2Retrace = w2Length / w1Length
            w3Extension = w3Length / w1Length
            w4Retrace = w4Length / w3Length

            // Wave 2: 50%, 61.8%, or 78.6% retracement
            if w2Retrace > 0.382 and w2Retrace < 0.886
                conf += 0.1

            // Wave 3: 161.8% or more extension
            if w3Extension > 1.5
                conf += 0.1

            // Wave 4: 38.2% to 50% retracement
            if w4Retrace > 0.3 and w4Retrace < 0.6
                conf += 0.1

    [detected, bullish, conf]

// Run detection
[isImpulse, isBull, confScore] = detectImpulseWave()

if isImpulse
    waveCount := 5
    currentPattern := "impulse"
    isBullish := isBull
    confidence := confScore

    wave1Start := array.get(pivotPrices, array.size(pivotPrices) - 6)
    wave1End := array.get(pivotPrices, array.size(pivotPrices) - 5)
    wave2End := array.get(pivotPrices, array.size(pivotPrices) - 4)
    wave3End := array.get(pivotPrices, array.size(pivotPrices) - 3)
    wave4End := array.get(pivotPrices, array.size(pivotPrices) - 2)
    wave5End := array.get(pivotPrices, array.size(pivotPrices) - 1)

    wave1StartBar := array.get(pivotBars, array.size(pivotBars) - 6)
    wave1EndBar := array.get(pivotBars, array.size(pivotBars) - 5)
    wave2EndBar := array.get(pivotBars, array.size(pivotBars) - 4)
    wave3EndBar := array.get(pivotBars, array.size(pivotBars) - 3)
    wave4EndBar := array.get(pivotBars, array.size(pivotBars) - 2)
    wave5EndBar := array.get(pivotBars, array.size(pivotBars) - 1)

// ==================== DRAWING FUNCTIONS ====================
var line[] waveLines = array.new_line(0)
var label[] waveLabels = array.new_label(0)
var line[] fibLines = array.new_line(0)
var label[] fibLabels = array.new_label(0)

// Clear previous drawings
clearDrawings() =>
    for i = 0 to array.size(waveLines) - 1
        line.delete(array.get(waveLines, i))
    array.clear(waveLines)

    for i = 0 to array.size(waveLabels) - 1
        label.delete(array.get(waveLabels, i))
    array.clear(waveLabels)

    for i = 0 to array.size(fibLines) - 1
        line.delete(array.get(fibLines, i))
    array.clear(fibLines)

    for i = 0 to array.size(fibLabels) - 1
        label.delete(array.get(fibLabels, i))
    array.clear(fibLabels)

// Draw wave pattern
drawWavePattern() =>
    if currentPattern == "impulse" and waveCount == 5
        waveColor = isBullish ? bullColor : bearColor

        if showWaveLines
            // Draw wave lines
            array.push(waveLines, line.new(wave1StartBar, wave1Start, wave1EndBar, wave1End, color=waveColor, width=2))
            array.push(waveLines, line.new(wave1EndBar, wave1End, wave2EndBar, wave2End, color=waveColor, width=2))
            array.push(waveLines, line.new(wave2EndBar, wave2End, wave3EndBar, wave3End, color=waveColor, width=3))  // Wave 3 thicker
            array.push(waveLines, line.new(wave3EndBar, wave3End, wave4EndBar, wave4End, color=waveColor, width=2))
            array.push(waveLines, line.new(wave4EndBar, wave4End, wave5EndBar, wave5End, color=waveColor, width=2))

        if showWaveLabels
            // Draw wave labels
            lblStyle = isBullish ? label.style_label_up : label.style_label_down
            lblStyleAlt = isBullish ? label.style_label_down : label.style_label_up

            array.push(waveLabels, label.new(wave1StartBar, wave1Start, "0", style=lblStyle, color=waveColor, textcolor=color.white, size=size.small))
            array.push(waveLabels, label.new(wave1EndBar, wave1End, "1", style=lblStyleAlt, color=waveColor, textcolor=color.white, size=size.small))
            array.push(waveLabels, label.new(wave2EndBar, wave2End, "2", style=lblStyle, color=waveColor, textcolor=color.white, size=size.small))
            array.push(waveLabels, label.new(wave3EndBar, wave3End, "3", style=lblStyleAlt, color=waveColor, textcolor=color.white, size=size.small))
            array.push(waveLabels, label.new(wave4EndBar, wave4End, "4", style=lblStyle, color=waveColor, textcolor=color.white, size=size.small))
            array.push(waveLabels, label.new(wave5EndBar, wave5End, "5", style=lblStyleAlt, color=waveColor, textcolor=color.white, size=size.small))

// Draw Fibonacci levels
drawFibLevels() =>
    if showFibLevels and currentPattern == "impulse"
        // Calculate key Fibonacci levels from Wave 1
        w1High = math.max(wave1Start, wave1End)
        w1Low = math.min(wave1Start, wave1End)
        w1Diff = w1High - w1Low

        // Retracement levels
        fib382 = w1High - w1Diff * 0.382
        fib500 = w1High - w1Diff * 0.5
        fib618 = w1High - w1Diff * 0.618
        fib786 = w1High - w1Diff * 0.786

        // Extension levels from Wave 4 end
        ext100 = wave4End + (isBullish ? w1Diff : -w1Diff)
        ext1618 = wave4End + (isBullish ? w1Diff * 1.618 : -w1Diff * 1.618)
        ext2618 = wave4End + (isBullish ? w1Diff * 2.618 : -w1Diff * 2.618)

        // Draw extension targets
        if showTargets
            array.push(fibLines, line.new(wave5EndBar, ext100, bar_index + 20, ext100, color=targetColor, style=line.style_dashed))
            array.push(fibLabels, label.new(bar_index + 22, ext100, "TP1: " + str.tostring(ext100, "#.##"), style=label.style_label_left, color=targetColor, textcolor=color.white, size=size.tiny))

            array.push(fibLines, line.new(wave5EndBar, ext1618, bar_index + 20, ext1618, color=targetColor, style=line.style_dashed))
            array.push(fibLabels, label.new(bar_index + 22, ext1618, "TP2: " + str.tostring(ext1618, "#.##"), style=label.style_label_left, color=targetColor, textcolor=color.white, size=size.tiny))

        // Draw invalidation level
        if showInvalidation
            invalidLevel = isBullish ? wave1End : wave1End
            array.push(fibLines, line.new(wave1EndBar, invalidLevel, bar_index + 20, invalidLevel, color=invalidColor, style=line.style_dotted, width=2))
            array.push(fibLabels, label.new(bar_index + 22, invalidLevel, "Invalid: " + str.tostring(invalidLevel, "#.##"), style=label.style_label_left, color=invalidColor, textcolor=color.white, size=size.tiny))

// Execute drawing on bar confirmation
if barstate.isconfirmed
    clearDrawings()
    drawWavePattern()
    drawFibLevels()

// ==================== SIGNALS & ALERTS ====================
// Buy signal: End of Wave 2 or Wave 4 in bullish impulse
buySignal = isImpulse and isBullish and (waveCount == 2 or waveCount == 4)

// Sell signal: End of Wave 5 in bullish impulse (take profit)
sellSignal = isImpulse and isBullish and waveCount == 5

// Short signal: End of Wave 2 or Wave 4 in bearish impulse
shortSignal = isImpulse and not isBullish and (waveCount == 2 or waveCount == 4)

// Cover signal: End of Wave 5 in bearish impulse
coverSignal = isImpulse and not isBullish and waveCount == 5

// Plot signals
plotshape(buySignal, title="Buy Signal", location=location.belowbar, color=bullColor, style=shape.triangleup, size=size.normal)
plotshape(sellSignal, title="Sell Signal", location=location.abovebar, color=bearColor, style=shape.triangledown, size=size.normal)
plotshape(shortSignal, title="Short Signal", location=location.abovebar, color=bearColor, style=shape.triangledown, size=size.normal)
plotshape(coverSignal, title="Cover Signal", location=location.belowbar, color=bullColor, style=shape.triangleup, size=size.normal)

// Alert conditions
alertcondition(buySignal, title="Buy Alert", message="Elliott Wave Buy Signal: Wave {{waveCount}} complete - bullish continuation expected")
alertcondition(sellSignal, title="Sell Alert", message="Elliott Wave Sell Signal: Wave 5 complete - expect correction")
alertcondition(shortSignal, title="Short Alert", message="Elliott Wave Short Signal: Wave {{waveCount}} complete - bearish continuation expected")
alertcondition(coverSignal, title="Cover Alert", message="Elliott Wave Cover Signal: Wave 5 complete - expect bounce")

// ==================== INFO TABLE ====================
var table infoTable = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 80), border_width=1)

if barstate.islast
    table.cell(infoTable, 0, 0, "Elliott Wave Analysis", text_color=color.white, text_size=size.small)
    table.cell(infoTable, 1, 0, "", text_color=color.white)

    table.cell(infoTable, 0, 1, "Pattern:", text_color=color.gray, text_size=size.tiny)
    table.cell(infoTable, 1, 1, currentPattern == "impulse" ? "5-Wave Impulse" : "Scanning...", text_color=color.white, text_size=size.tiny)

    table.cell(infoTable, 0, 2, "Trend:", text_color=color.gray, text_size=size.tiny)
    table.cell(infoTable, 1, 2, isBullish ? "BULLISH" : "BEARISH", text_color=isBullish ? bullColor : bearColor, text_size=size.tiny)

    table.cell(infoTable, 0, 3, "Wave Count:", text_color=color.gray, text_size=size.tiny)
    table.cell(infoTable, 1, 3, str.tostring(waveCount), text_color=color.white, text_size=size.tiny)

    table.cell(infoTable, 0, 4, "Confidence:", text_color=color.gray, text_size=size.tiny)
    table.cell(infoTable, 1, 4, str.tostring(confidence * 100, "#.#") + "%", text_color=confidence > 0.7 ? bullColor : color.yellow, text_size=size.tiny)

    table.cell(infoTable, 0, 5, "Signal:", text_color=color.gray, text_size=size.tiny)
    signalText = buySignal ? "BUY" : sellSignal ? "SELL" : shortSignal ? "SHORT" : coverSignal ? "COVER" : "WAIT"
    signalColor = buySignal or coverSignal ? bullColor : sellSignal or shortSignal ? bearColor : color.gray
    table.cell(infoTable, 1, 5, signalText, text_color=signalColor, text_size=size.tiny)
